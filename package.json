{
  "name": "mobile-app-testing-mcp",
  "version": "1.0.0",
  "description": "移动端App测试MCP - 完整的移动应用安全测试和自动化平台",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node scripts/start.js",
    "dev": "npm run build && node scripts/start.js",
    "test": "node --test dist/test/*.js",
    "install:mcp": "node scripts/install-mcp.js --target all",
    "install:mcp:codex": "node scripts/install-mcp.js --target codex",
    "install:mcp:claude": "node scripts/install-mcp.js --target claude",
    "setup": "node scripts/setup.js",
    "setup:legacy": "chmod +x scripts/setup.sh && scripts/setup.sh",
    "check": "node scripts/check-env.js",
    "smoke": "node scripts/smoke-mcp.js",
    "verify": "npm run build && npm run check && npm run smoke"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mobile-testing",
    "app-security",
    "mcp",
    "adb",
    "aapt",
    "jadx",
    "android",
    "automation",
    "security-testing"
  ],
  "author": "",
  "license": "MIT"
}
