# 移动端App测试MCP 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# Android SDK 路径 (必需)
# 设置其中一个即可，ANDROID_HOME 优先级更高
ANDROID_HOME=/path/to/android/sdk
# ANDROID_SDK_ROOT=/path/to/android/sdk

# 可执行文件路径覆盖 (按需设置，默认从系统PATH查找)
# ADB_PATH=adb
# AAPT_PATH=aapt
# JADX_PATH=jadx

# 常见的Android SDK路径示例:
# macOS: /Users/username/Library/Android/sdk
# Linux: /home/username/Android/Sdk  
# Windows: C:\Users\username\AppData\Local\Android\Sdk

# MCP服务器配置
# 服务器端口 (可选，默认使用stdio)
# MCP_PORT=3000

# 日志级别 (可选)
# LOG_LEVEL=info

# JADX配置 (可选)
# JADX_PATH=/path/to/jadx/bin/jadx
# AUTO_DOWNLOAD_JADX=true
# JADX_VERSION=1.5.5
# JADX_DOWNLOAD_URL=https://github.com/skylot/jadx/releases/download/v1.5.5/jadx-1.5.5.zip

# 工作目录配置 (可选)
# WORK_DIR=/path/to/working/directory
# SCREENSHOTS_DIR=/path/to/screenshots
# RECORDINGS_DIR=/path/to/recordings
# DECOMPILED_DIR=/path/to/decompiled
# LOGS_DIR=/path/to/logs
